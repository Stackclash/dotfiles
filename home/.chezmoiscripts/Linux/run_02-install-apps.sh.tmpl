#!/bin/bash
# -------------------------------------------------------
# Installs apps.yaml `linux:` entries with this distro's package managers.
# The manager list comes from .chezmoidata/linux-package-managers.yaml, keyed
# by .chezmoi.osRelease.id then .chezmoi.osRelease.idLike, or from the
# per-machine `packageManagers` override in ~/.config/chezmoi/chezmoi.json.
# Each app uses the first manager in that list it defines a key for.
# Runs every apply and upgrades the system first, like `brew upgrade` on macOS
# and `winget upgrade` on Windows. Arch only supports full upgrades, so this
# is a system upgrade, through `omarchy update` on Omarchy.
# -------------------------------------------------------
{{- /* ---- choose the manager list ---- */}}
{{- $pmMap := .linuxPackageManagers }}
{{- $distro := .chezmoi.osRelease.id | default "" }}
{{- $managers := list }}
{{- if .packageManagers }}
{{-   $managers = .packageManagers }}
{{- else if hasKey $pmMap $distro }}
{{-   $managers = index $pmMap $distro }}
{{- else }}
{{-   range splitList " " (.chezmoi.osRelease.idLike | default "") }}
{{-     if and (not $managers) (hasKey $pmMap .) }}
{{-       $managers = index $pmMap . }}
{{-     end }}
{{-   end }}
{{- end }}
{{- /* ---- bucket each app by its chosen manager ---- */}}
{{- $pkgs := dict }}
{{- $installers := list }}
{{- $shipped := list }}
{{- $skipped := list }}
{{- $workComputer := .workComputer }}
{{- range $name, $app := .apps }}
{{-   if and $workComputer $app.forPersonal }}
{{-     $skipped = append $skipped (printf "%s (personal app on a work computer)" $name) }}
{{-   else if $app.linux }}
{{-     $chosen := "" }}
{{-     range $m := $managers }}
{{-       if and (not $chosen) (hasKey $app.linux $m) }}{{ $chosen = $m }}{{ end }}
{{-     end }}
{{-     if not $chosen }}
{{-       $skipped = append $skipped (printf "%s (no linux entry for: %s)" $name (join ", " $managers)) }}
{{-     else if eq $chosen "omarchy" }}
{{-       $entry := index $app.linux "omarchy" }}
{{-       if kindIs "string" $entry }}
{{-         $shipped = append $shipped $name }}
{{-       else }}
{{-         $installers = append $installers (printf "%s|%s|%s" $name $entry.installer $entry.package) }}
{{-       end }}
{{-     else }}
{{-       $_ := set $pkgs $chosen (append (get $pkgs $chosen | default list) (index $app.linux $chosen)) }}
{{-     end }}
{{-   end }}
{{- end }}

set -u
FAILED=0
{{- if includeTemplate "is-omarchy" . }}
OMARCHY=1
{{- else }}
OMARCHY=0
{{- end }}

echo "Installing Linux apps ({{ $distro }}: {{ join ", " $managers | default "no package managers configured" }})"
{{- if not $managers }}
echo "  No package manager list for '{{ $distro }}' (idLike: '{{ .chezmoi.osRelease.idLike | default "" }}')." >&2
echo "  Add it to .chezmoidata/linux-package-managers.yaml or set packageManagers in chezmoi.json." >&2
exit 0
{{- end }}

# is_installed MANAGER PKG
is_installed() {
  case "$1" in
    pacman|aur) pacman -Q -- "$2" >/dev/null 2>&1 ;;
    apt) dpkg-query -W -f='${Status}' "$2" 2>/dev/null | grep -q "install ok installed" ;;
    dnf) rpm -q "$2" >/dev/null 2>&1 ;;
    *)   return 1 ;;
  esac
}

# Plan first: queue only what is missing, so a run with nothing to do never
# asks for sudo.
declare -A TODO=()
INSTALLERS=()
queue() { local m="$1" p; shift; for p in "$@"; do is_installed "$m" "$p" || TODO[$m]+="$p "; done; }
queue_installer() { pacman -Q -- "$3" >/dev/null 2>&1 || INSTALLERS+=("$1|$2|$3"); }
MANAGER_ORDER=({{ range $managers }}{{ if ne . "omarchy" }}{{ . | quote }} {{ end }}{{ end }})
{{- range $m := $managers }}
{{-   if and (ne $m "omarchy") (get $pkgs $m) }}
queue {{ $m }} {{ range get $pkgs $m }}{{ . | quote }} {{ end }}
{{-   end }}
{{- end }}
{{- range $installers }}
{{-   $parts := splitList "|" . }}
queue_installer {{ index $parts 0 | quote }} {{ index $parts 1 | quote }} {{ index $parts 2 | quote }}
{{- end }}

aur_helper() {
  if command -v yay >/dev/null 2>&1; then echo yay
  elif command -v paru >/dev/null 2>&1; then echo paru
  else return 1; fi
}

# Upgrades are checked without root too. checkupdates exits 0 when updates are
# pending and 2 when there are none; without it (no pacman-contrib) the upgrade
# always runs. apt reads its existing package lists, which apt-daily refreshes.
UPGRADES=()
pacman_pending() { if command -v checkupdates >/dev/null 2>&1; then checkupdates >/dev/null 2>&1; else return 0; fi; }
aur_pending() { local h; h="$(aur_helper)" && [ -n "$("$h" -Qua 2>/dev/null)" ]; }
if [ $OMARCHY -eq 1 ]; then
  { pacman_pending || aur_pending; } && UPGRADES+=(omarchy)
else
  for m in "${MANAGER_ORDER[@]}"; do
    case "$m" in
      pacman) pacman_pending && UPGRADES+=(pacman) ;;
      aur)    aur_pending && UPGRADES+=(aur) ;;
      apt)    apt list --upgradable 2>/dev/null | grep -q 'upgradable from' && UPGRADES+=(apt) ;;
      dnf)    dnf check-update -q >/dev/null 2>&1; [ $? -eq 100 ] && UPGRADES+=(dnf) ;;
    esac
  done
fi

# upgrade_with MANAGER
upgrade_with() {
  echo "  [$1] upgrading"
  case "$1" in
    omarchy) omarchy-update -y ;;
    pacman)  sudo pacman -Syu --noconfirm ;;
    aur)     "$(aur_helper)" -Sua --noconfirm ;;
    apt)     sudo apt-get update && sudo apt-get upgrade -y ;;
    dnf)     sudo dnf upgrade -y ;;
  esac
}

# Ask for the sudo password once, then keep the cached credential fresh in the
# background until this script exits. Long AUR builds or downloads can outlast
# sudo's timestamp_timeout. pacman, yay and the Omarchy installers run in this
# terminal, so they all reuse it.
start_sudo_once() {
  [ "$(id -u)" -eq 0 ] && return 0
  echo "  Root access is needed for the changes above - enter your password once."
  sudo -v || return 1
  ( while kill -0 "$$" 2>/dev/null; do sudo -n -v 2>/dev/null; sleep 60; done ) &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
}

# install_with MANAGER PKG...
install_with() {
  local manager="$1"; shift
  [ $# -gt 0 ] || return 0
  echo "  [$manager] $*"
  case "$manager" in
    pacman)
      if [ $OMARCHY -eq 1 ]; then omarchy-pkg-add "$@"
      else sudo pacman -S --needed --noconfirm -- "$@"; fi ;;
    aur)
      if [ $OMARCHY -eq 1 ]; then omarchy-pkg-aur-add "$@"
      elif command -v yay >/dev/null 2>&1; then yay -S --needed --noconfirm -- "$@"
      elif command -v paru >/dev/null 2>&1; then paru -S --needed --noconfirm -- "$@"
      else echo "  no AUR helper (yay/paru) found" >&2; return 1; fi ;;
    apt) sudo apt-get install -y "$@" ;;
    dnf) sudo dnf install -y "$@" ;;
    *)   echo "  unknown package manager '$manager'" >&2; return 1 ;;
  esac
}

# run_installer NAME|INSTALLER|PACKAGE -- Omarchy installers also configure and
# launch the app, so they are only queued when the package is missing.
run_installer() {
  local name installer package
  IFS='|' read -r name installer package <<<"$1"
  echo "  [omarchy] $name: omarchy-install-$installer"
  "omarchy-install-$installer"
}

pending=0
[ ${#UPGRADES[@]} -gt 0 ] && { echo "  To upgrade: ${UPGRADES[*]}"; pending=1; }
for m in "${MANAGER_ORDER[@]}"; do
  if [ -n "${TODO[$m]:-}" ]; then echo "  To install with $m: ${TODO[$m]}"; pending=1; fi
done
for i in "${INSTALLERS[@]}"; do echo "  To install with omarchy-install: ${i%%|*}"; pending=1; done

if [ $pending -eq 0 ]; then
  echo "  Everything is installed and up to date."
elif start_sudo_once; then
  # Upgrade first, so new installs come from the same package database.
  for u in "${UPGRADES[@]}"; do upgrade_with "$u" || FAILED=1; done
  for m in "${MANAGER_ORDER[@]}"; do
    # shellcheck disable=SC2086 # word-split the queued package list
    [ -n "${TODO[$m]:-}" ] && { install_with "$m" ${TODO[$m]} || FAILED=1; }
  done
  for i in "${INSTALLERS[@]}"; do run_installer "$i" || FAILED=1; done
else
  echo "  sudo was not granted - skipping installs. Run 'chezmoi apply' to retry." >&2
  FAILED=1
fi

{{- if $shipped }}

echo "  Provided by Omarchy: {{ join ", " $shipped }}"
{{- end }}
{{- if $skipped }}
echo "  Skipped:"
{{-   range $skipped }}
echo "    - {{ . }}"
{{-   end }}
{{- end }}

if [ $FAILED -ne 0 ]; then
  echo "Some apps failed to install - fix the errors above and run 'chezmoi apply' again." >&2
fi
exit 0
