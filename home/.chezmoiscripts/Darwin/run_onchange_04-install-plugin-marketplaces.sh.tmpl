#!/bin/bash

clis=()
command -v claude >/dev/null 2>&1 && clis+=("claude")
command -v copilot >/dev/null 2>&1 && clis+=("copilot")

if [ ${#clis[@]} -eq 0 ]; then
  echo "Neither 'claude' nor 'copilot' CLI found in PATH. Skipping plugin marketplace setup."
  exit 0
fi

{{- range $key, $plugin := .aiTools.pluginMarketplaces }}
{{- $targets := $plugin.clis }}
{{- if not $targets }}{{ $targets = list "claude" "copilot" }}{{ end }}

echo ""
echo "=== Plugin: {{ $key }} ==="
plugin_clis=({{ range $t := $targets }}"{{ $t }}" {{ end }})
for cli in "${clis[@]}"; do
  match=false
  for t in "${plugin_clis[@]}"; do
    [ "$cli" = "$t" ] && match=true && break
  done
  [ "$match" = false ] && continue

  echo "[$cli] Adding marketplace {{ $plugin.marketplace }}..."
  "$cli" plugin marketplace add {{ $plugin.marketplace }} || true

  echo "[$cli] Installing plugin {{ $plugin.plugin }}..."
  "$cli" plugin install {{ $plugin.plugin }} || true
done
{{- end }}

echo ""
echo "Plugin marketplaces processed."
