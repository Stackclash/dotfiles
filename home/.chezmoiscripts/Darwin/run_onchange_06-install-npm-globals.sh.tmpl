#!/bin/bash

if ! command -v npm >/dev/null 2>&1; then
  echo "'npm' not found in PATH. Skipping global npm package setup."
  exit 0
fi

{{- range $pkg := .aiTools.npmGlobal }}

echo ""
echo "=== npm global: {{ $pkg }} ==="
npm install -g {{ $pkg }}
{{- end }}

echo ""
echo "Global npm packages processed."
