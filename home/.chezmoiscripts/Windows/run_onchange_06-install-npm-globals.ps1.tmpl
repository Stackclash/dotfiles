if (-not (Get-Command "npm" -ErrorAction SilentlyContinue)) {
    Write-Host "'npm' not found in PATH. Skipping global npm package setup."
    exit 0
}

{{- range $pkg := .aiTools.npmGlobal }}

Write-Host ""
Write-Host "=== npm global: {{ $pkg }} ==="
npm install -g {{ $pkg }}
{{- end }}

Write-Host ""
Write-Host "Global npm packages processed."
