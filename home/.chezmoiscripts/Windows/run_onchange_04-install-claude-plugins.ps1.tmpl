if (-not (Get-Command "claude" -ErrorAction SilentlyContinue)) {
    Write-Host "'claude' CLI not found in PATH. Skipping Claude Code plugin setup."
    exit 0
}

{{- range $key, $plugin := .aiTools.claudePlugins }}

Write-Host ""
Write-Host "=== Claude Code plugin: {{ $key }} ==="
Write-Host "Adding marketplace {{ $plugin.marketplace }}..."
claude plugin marketplace add {{ $plugin.marketplace }}

Write-Host "Installing plugin {{ $plugin.plugin }}..."
claude plugin install {{ $plugin.plugin }}
{{- end }}

Write-Host ""
Write-Host "Claude Code plugins processed."
