{{- /* Work setup only: renders empty (so chezmoi skips it) otherwise. */ -}}
{{- if or .workComputer .setupWork -}}
# NOT elevated: repos cloned by an elevated process are owned by Administrators,
# and git then refuses them as "dubious ownership" in a normal shell.
{{ template "mise-path" . }}

gh auth status >$null 2>&1
if ($LASTEXITCODE -ne 0) {
    gh auth login -p https --web
}

$projectPath = '{{ includeTemplate "project-path" . | replace "'" "''" }}' + "\Work"
$workGithubOrg = {{ .workGithubOrg | quote }}
$githubUsername = {{ .githubUsername | quote }}
$dateQuery = ">=" + (Get-Date).AddDays(-365).ToString('yyyy-MM-dd') # 1 year ago
$repos = gh repo list $workGithubOrg --source --json name,nameWithOwner | ConvertFrom-Json

foreach ($repo in $repos) {
    # gh signals failure through its exit code, which try/catch does not see.
    $commits = gh search commits --repo $repo.nameWithOwner --committer $githubUsername --committer-date $dateQuery
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Could not search $($repo.nameWithOwner), possibly due to GitHub API rate limits. Wait a couple of minutes and try again." -ForegroundColor Red
        exit 1
    }

    if ($commits) {
        $repoPath = Join-Path -Path $projectPath -ChildPath $repo.name

        if (-Not (Test-Path $repoPath)) {
            gh repo clone $repo.nameWithOwner $repoPath
        } else {
            echo "$repoPath already exists"
        }
    }
}
{{- end }}
