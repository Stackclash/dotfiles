# -------------------------------------------------------
# AI Tools Sync (PowerShell, templated)
# Installs/updates AI tools declared in .chezmoidata/ai-tools.yaml for every
# agent declared in .chezmoidata/ai-agents.yaml (an entry with no `agents:`
# list targets all of them). Nothing in this script names an agent: where a
# tool goes and how is read from the agent's registry entry.
#   aiTools.mcp     -> registers the server per the agent's mcp.method
#                      (claude-cli | vscode-json | codex-toml)
#   aiTools.plugin  -> adds the marketplace + installs the plugin (plugins.supported agents)
#   aiTools.skill   -> installs a published skill via `npx skills add --agent <skills.cliAgent>`
#   aiTools.package -> runs any postInstall step (the package itself is handled by mise)
#   aiTools.custom  -> copies your authored skill/agent from ~/.ai into each agent's skills.dir / skills.agentsDir
# forPersonal-skipped tools are reported, never installed.
# vscode-json MCP servers are provided via the managed VS Code mcp.json instead.
#
# Output is grouped as category -> item -> one status line per agent. Child
# command output is captured, not echoed; failures show the last line inline
# and a manual retry command under "Follow-ups".
#
# NOT elevated — MCPs/skills must register for the current user, not Administrator.
# Every external command is best-effort so `chezmoi apply` never fails on a
# not-yet-installed CLI.
# -------------------------------------------------------
# ai-tools.yaml + ai-agents.yaml hash: {{ list .aiTools .aiAgents | toString | sha256sum }}
{{ template "mise-path" . }}

$script:Notes = @()
$script:Counts = @{ ok = 0; skip = 0; fail = 0 }
$script:TomlResult = @{}
$script:Tracked = New-Object System.Collections.Generic.List[string]
function Add-Note { param([string]$Text) $script:Notes += $Text }
function Add-Tracked { param([string]$Key) [void]$script:Tracked.Add($Key) }
function Test-Cmd { param([string]$Name) [bool](Get-Command $Name -ErrorAction SilentlyContinue) }

function Write-Category {
    param([string]$Title)
    Write-Host ""
    Write-Host $Title -ForegroundColor Cyan
    Write-Host ("-" * $Title.Length) -ForegroundColor Cyan
}

function Write-Item {
    param([string]$Name, [string]$Detail)
    Write-Host "  $Name" -NoNewline
    if ($Detail) { Write-Host " ($Detail)" -ForegroundColor DarkGray } else { Write-Host "" }
}

function Write-Status {
    param([string]$Label, [ValidateSet('ok', 'skip', 'fail')][string]$Status, [string]$Detail)
    $script:Counts[$Status]++
    $tag, $color = switch ($Status) {
        'ok'   { '[ ok ]', 'Green' }
        'skip' { '[skip]', 'DarkGray' }
        'fail' { '[FAIL]', 'Red' }
    }
    $line = "    $tag $Label"
    if ($Detail) { $line += " - $Detail" }
    Write-Host $line -ForegroundColor $color
}

function Get-LastLine {
    param($Out)
    $lines = @($Out | ForEach-Object { "$_".Trim() } | Where-Object { $_ })
    if (-not $lines.Count) { return "" }
    $last = $lines[-1]
    if ($last.Length -gt 100) { $last.Substring(0, 100) + "..." } else { $last }
}

# Windows PowerShell 5.1 (chezmoi's .ps1 interpreter) rebuilds a native command
# line from the argument strings without reliably escaping embedded double
# quotes, so '{"a":1}' can reach the child as '{a:1}' and `claude mcp add-json`
# dies with "Invalid configuration: : Invalid input". Whether it breaks depends
# on the content (a space, as in "Bearer <token>", was enough), so no amount of
# pre-escaping the argument is dependable. Build the exact command line instead
# (CommandLineToArgvW rules) and start the process directly.
function ConvertTo-ArgvQuoted {
    param([string]$Value)
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.Append('"')
    $backslashes = 0
    foreach ($c in $Value.ToCharArray()) {
        if ($c -eq [char]92) { $backslashes++; continue }
        if ($c -eq [char]34) { [void]$sb.Append([string]::new([char]92, $backslashes * 2 + 1)).Append('"') }
        else { [void]$sb.Append([string]::new([char]92, $backslashes)).Append($c) }
        $backslashes = 0
    }
    [void]$sb.Append([string]::new([char]92, $backslashes * 2)).Append('"')
    $sb.ToString()
}

# Runs a native command with Arguments passed through verbatim; returns
# @{ Code; Output } with stdout and stderr merged.
function Invoke-NativeExact {
    param([string]$Command, [string]$ArgLine)
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = (Get-Command $Command).Source
    $psi.Arguments = $ArgLine
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $p = [System.Diagnostics.Process]::Start($psi)
    $stdout = $p.StandardOutput.ReadToEndAsync()
    $stderr = $p.StandardError.ReadToEndAsync()
    $p.WaitForExit()
    @{ Code = $p.ExitCode; Output = ($stdout.Result + $stderr.Result) }
}

function Register-ClaudeMcp {
    param([string]$Name, [string]$Label, [string]$Json)
    if (-not (Test-Cmd "claude")) {
        Write-Status -Label $Label -Status fail -Detail "claude CLI not found"
        Add-Note "claude CLI not found - register MCP '$Name' later with 'chezmoi apply'."
        return
    }
    # A template that resolved to nothing (a missing Doppler secret, most often)
    # renders as "<no value>". Registering that would store a broken server, and
    # its angle brackets are cmd.exe redirection operators, so they also corrupt
    # the command line on the way to a .cmd-shimmed claude.
    if ($Json -match '<no value>') {
        Write-Status -Label $Label -Status fail -Detail "config rendered '<no value>'"
        Add-Note "MCP '$Name' skipped - its config rendered '<no value>', so a template (usually a Doppler secret) did not resolve. Check the secret name in .chezmoidata/ai-tools.yaml, then re-run 'chezmoi apply --force'."
        return
    }
    [void](Invoke-NativeExact -Command "claude" -ArgLine "mcp remove $(ConvertTo-ArgvQuoted $Name) --scope user")
    $r = Invoke-NativeExact -Command "claude" -ArgLine "mcp add-json --scope user $(ConvertTo-ArgvQuoted $Name) $(ConvertTo-ArgvQuoted $Json)"
    if ($r.Code -eq 0) { Write-Status -Label $Label -Status ok -Detail "registered" }
    else {
        Write-Status -Label $Label -Status fail -Detail "exit $($r.Code): $(Get-LastLine $r.Output)"
        Add-Note "Failed to register Claude MCP '$Name' (claude mcp add-json exited $($r.Code))."
    }
}

function Install-Plugin {
    param([string]$Name, [string]$Label, [string]$Cli, [string]$MarketplaceAdd, [string]$Install)
    if (-not (Test-Cmd $Cli)) {
        Write-Status -Label $Label -Status fail -Detail "$Cli not found"
        Add-Note "$Cli not found - install plugin '$Name' later: $Cli plugin install $Install"
        return
    }
    $marketplaceFailed = $false
    if ($MarketplaceAdd) {
        & $Cli plugin marketplace add $MarketplaceAdd 2>&1 | Out-Null
        if ($LASTEXITCODE -ne 0) { $marketplaceFailed = $true }
    }
    $out = & $Cli plugin install $Install 2>&1
    $code = $LASTEXITCODE
    if ($code -eq 0) { Write-Status -Label $Label -Status ok -Detail "installed"; return }
    $detail = "exit ${code}: $(Get-LastLine $out)"
    if ($marketplaceFailed) { $detail += " (marketplace add '$MarketplaceAdd' also failed)" }
    Write-Status -Label $Label -Status fail -Detail $detail
    $note = "Could not install plugin '$Name' for $Cli (exit $code) - run manually: $Cli plugin install $Install"
    if (($out | Out-String) -match 'os error 5|Access is denied') {
        # github/copilot-cli#4095 / #4151: Windows cannot replace the installed-plugins
        # folder while VS Code or a live CLI session holds watcher handles on it.
        $note += ". Windows denied the plugin folder swap - close VS Code and any running $Cli session, then re-run 'chezmoi apply --force'."
    }
    Add-Note $note
}

function Install-Skill {
    param([string]$Name, [string]$Label, [string]$Repo, [string]$Skill, [string]$Agent)
    $cliArgs = @("skills", "add", $Repo)
    if ($Skill) { $cliArgs += @("--skill", $Skill) }
    $cliArgs += @("--agent", $Agent, "-g", "-y")
    $manual = "npx --yes $($cliArgs -join ' ')"
    if (-not (Test-Cmd "npx")) {
        Write-Status -Label $Label -Status fail -Detail "npx not found"
        Add-Note "npx not found - install skill '$Name' later: $manual"
        return
    }
    $out = & npx --yes @cliArgs 2>&1
    if ($LASTEXITCODE -eq 0) { Write-Status -Label $Label -Status ok -Detail "installed" }
    else {
        Write-Status -Label $Label -Status fail -Detail "exit ${LASTEXITCODE}: $(Get-LastLine $out)"
        Add-Note "Could not install skill '$Name' for $Agent - run manually: $manual"
    }
}

function Invoke-PostInstall {
    param([string]$Name, [string]$Cmd)
    $LASTEXITCODE = 0
    try {
        $out = Invoke-Expression $Cmd 2>&1
        if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE`: $(Get-LastLine $out)" }
        Write-Status -Label "postInstall: $Cmd" -Status ok
    } catch {
        Write-Status -Label "postInstall: $Cmd" -Status fail -Detail $_.Exception.Message
        Add-Note "postInstall for '$Name' failed - run manually: $Cmd"
    }
}

function Update-SkillManifest {
    param([string]$Name, [string]$Manifest)   # Manifest is relative to $HOME
    $path = Join-Path $HOME $Manifest
    if (-not (Test-Path $path)) { return }
    try {
        $json = Get-Content $path -Raw | ConvertFrom-Json
        $skills = @($json.skills)
        if ($skills -notcontains $Name) {
            $json.skills = @(($skills + $Name) | Sort-Object)
            $json | ConvertTo-Json -Depth 20 | Set-Content $path
        }
    } catch { Add-Note "Could not update $path for '$Name'." }
}

function Remove-SkillManifestEntry {
    param([string]$Name, [string]$Manifest)   # Manifest is relative to $HOME
    $path = Join-Path $HOME $Manifest
    if (-not (Test-Path $path)) { return }
    try {
        $json = Get-Content $path -Raw | ConvertFrom-Json
        $skills = @($json.skills)
        if ($skills -contains $Name) {
            $json.skills = @($skills | Where-Object { $_ -ne $Name })
            $json | ConvertTo-Json -Depth 20 | Set-Content $path
        }
    } catch { Add-Note "Could not update $path to drop '$Name'." }
}

# DestDir is relative to $HOME and empty when the agent has no such directory.
function Copy-Custom {
    param([string]$Name, [string]$Label, [string]$Kind, [string]$DestDir, [string]$Manifest)
    $sub = if ($Kind -eq "agent") { "agents" } else { "skills" }
    if (-not $DestDir) { Write-Status -Label $Label -Status skip -Detail "no user-level $sub directory"; return }
    $src = Join-Path $HOME ".ai/$sub/$Name"
    if (-not (Test-Path $src)) {
        Write-Status -Label $Label -Status fail -Detail "no source at $src"
        Add-Note "custom $Kind '$Name' has no source at $src - author it under home/dot_ai/$sub/$Name/."
        return
    }
    $dest = Join-Path $HOME "$DestDir/$Name"
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $dest -Parent) | Out-Null
        if (Test-Path $dest) { Remove-Item -Recurse -Force $dest }
        Copy-Item -Recurse -Force $src $dest
    } catch {
        Write-Status -Label $Label -Status fail -Detail $_.Exception.Message
        Add-Note "Could not copy custom $Kind '$Name' to $dest."
        return
    }
    if ($Kind -eq "skill" -and $Manifest) { Update-SkillManifest -Name $Name -Manifest $Manifest }
    Write-Status -Label $Label -Status ok -Detail "copied to ~/$DestDir/$Name"
}

# Owns one marker-delimited block in the agent's config file (File is relative
# to $HOME) and leaves the rest of the file -- Codex keeps trust levels and
# other state there -- untouched. Returns $true on success.
function Sync-TomlMcp {
    param([string]$Agent, [string]$File, [string]$Body)
    $path = Join-Path $HOME $File
    $begin = "# BEGIN chezmoi ai-tools mcp"
    $end = "# END chezmoi ai-tools mcp"
    $Body = $Body.Trim()
    if ($Body -match '<no value>') {
        Add-Note "$Agent MCP block skipped - a config rendered '<no value>', so a template (usually a Doppler secret) did not resolve. Check the secret names in .chezmoidata/ai-tools.yaml, then re-run 'chezmoi apply --force'."
        return $false
    }
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $path -Parent) | Out-Null
        $existing = if (Test-Path $path) { Get-Content $path -Raw } else { "" }
        if ($null -eq $existing) { $existing = "" }
        # Drop any previous managed block, then append the fresh one.
        $pattern = "(?s)" + [regex]::Escape($begin) + ".*?" + [regex]::Escape($end)
        $kept = ([regex]::Replace($existing, $pattern, "")).TrimEnd()
        $text = if ($kept) { "$kept`n`n" } else { "" }
        if ($Body) { $text += "$begin`n$Body`n$end`n" } elseif ($kept) { $text = "$kept`n" }
        [System.IO.File]::WriteAllText($path, $text, (New-Object System.Text.UTF8Encoding($false)))
        return $true
    } catch {
        Add-Note "Could not write $Agent MCP block to ${path}: $($_.Exception.Message)"
        return $false
    }
}

function Write-TomlStatus {
    param([string]$Agent, [string]$Label, [string]$File)
    if ($script:TomlResult[$Agent]) { Write-Status -Label $Label -Status ok -Detail "written to ~/$File" }
    else { Write-Status -Label $Label -Status fail -Detail "could not write ~/$File" }
}

# Removes tools a previous run installed that ai-tools.yaml no longer declares.
# Every installed item is tracked as a `type|a|b|c` line in a per-machine state
# file; lines absent from this run are uninstalled. A failed removal stays in
# the file and is retried next run. No state file (first run) removes nothing.
function Invoke-Prune {
    $stateFile = Join-Path $HOME ".local/state/chezmoi-ai-tools.state"
    $tracked = @($script:Tracked | Sort-Object -Unique)
    $previous = if (Test-Path $stateFile) { @(Get-Content $stateFile) } else { @() }
    $gone = 'not found|not installed|no such|does not exist|no mcp server'
    $kept = @()
    $shown = $false
    foreach ($line in $previous) {
        if (-not "$line".Trim() -or $tracked -contains $line) { continue }
        $f = "$line".Split('|')
        if ($f.Count -lt 4) { continue }
        if (-not $shown) { Write-Category "Cleanup"; $shown = $true }
        $ok = $false
        $detail = ""
        switch ($f[0]) {
            'mcp' {
                # f[1] is the agent's mcp.method; only methods that register
                # per-server through a CLI are tracked (the rest are regenerated).
                switch ($f[1]) {
                    'claude-cli' {
                        if (-not (Test-Cmd "claude")) { $detail = "claude CLI not found"; break }
                        $r = Invoke-NativeExact -Command "claude" -ArgLine "mcp remove $(ConvertTo-ArgvQuoted $f[2]) --scope user"
                        $ok = ($r.Code -eq 0) -or ($r.Output -match $gone)
                        $detail = Get-LastLine $r.Output
                    }
                    default { $ok = $true; $detail = "no removal for mcp.method '$($f[1])'" }
                }
            }
            'plugin' {
                if (-not (Test-Cmd $f[1])) { $detail = "$($f[1]) not found"; break }
                $out = & $f[1] plugin uninstall $f[2] 2>&1
                $ok = ($LASTEXITCODE -eq 0) -or (($out | Out-String) -match $gone)
                $detail = Get-LastLine $out
            }
            'skill' {
                if (-not (Test-Cmd "npx")) { $detail = "npx not found"; break }
                $out = & npx --yes skills remove $f[2] --agent $f[1] -g -y 2>&1
                $ok = ($LASTEXITCODE -eq 0) -or (($out | Out-String) -match $gone)
                $detail = Get-LastLine $out
            }
            'custom' {
                if (-not $f[1] -or -not $f[2] -or $f[1] -match '\.\.' -or $f[2] -match '\.\.|[\\/]') {
                    $ok = $true; $detail = "ignored unsafe state entry"; break
                }
                try {
                    $target = Join-Path $HOME "$($f[1])/$($f[2])"
                    if (Test-Path $target) { Remove-Item -Recurse -Force $target }
                    if ($f[3]) { Remove-SkillManifestEntry -Name $f[2] -Manifest $f[3] }
                    $ok = $true
                } catch { $detail = $_.Exception.Message }
            }
            default { $ok = $true; $detail = "ignored unknown state entry" }
        }
        $label = "$($f[0]) $($f[2]) ($($f[1]))"
        if ($ok) { Write-Status -Label $label -Status ok -Detail "removed" }
        else {
            Write-Status -Label $label -Status fail -Detail $detail
            Add-Note "Could not remove '$($f[2])' ($($f[0])) - it is no longer in ai-tools.yaml; remove it manually. Retrying next run."
            $kept += $line
        }
    }
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $stateFile -Parent) | Out-Null
        $all = [string[]]@(@($tracked) + @($kept) | Sort-Object -Unique)
        [System.IO.File]::WriteAllLines($stateFile, $all, (New-Object System.Text.UTF8Encoding($false)))
    } catch { Add-Note "Could not write $stateFile - tools removed from ai-tools.yaml will not be cleaned up." }
}

Write-Host "Syncing AI tools"
{{- $agentNames := keys .aiAgents | sortAlpha }}

# -- MCP servers ----------------------------------------
Write-Category "MCP servers"
{{- range $agentName := $agentNames }}
{{- $agent := index $.aiAgents $agentName }}
{{- if eq $agent.mcp.method "codex-toml" }}
$script:TomlResult['{{ $agentName }}'] = Sync-TomlMcp -Agent '{{ $agentName }}' -File '{{ $agent.mcp.file }}' -Body @'
{{- range $name, $tool := $.aiTools.mcp }}
{{- if not (and $tool.forPersonal $.workComputer) }}
{{- if includeTemplate "ai-targets" (dict "tool" $tool "agent" $agentName "agents" $.aiAgents) }}

{{ includeTemplate "mcp-server-toml" (dict "name" $name "config" $tool.config) | trim }}
{{- end }}
{{- end }}
{{- end }}
'@
{{- end }}
{{- end }}
{{- range $name, $tool := .aiTools.mcp }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Item -Name '{{ $name }}' -Detail 'skipped: personal tool on a work computer'
{{- else }}
Write-Item -Name '{{ $name }}'
{{- range $agentName := $agentNames }}
{{- $agent := index $.aiAgents $agentName }}
{{- if includeTemplate "ai-targets" (dict "tool" $tool "agent" $agentName "agents" $.aiAgents) }}
{{- if eq $agent.mcp.method "claude-cli" }}
Add-Tracked 'mcp|{{ $agent.mcp.method }}|{{ $name }}|'
Register-ClaudeMcp -Name '{{ $name }}' -Label '{{ $agent.displayName }}' -Json '{{ includeTemplate "mcp-server-json" $tool.config | replace "'" "''" }}'
{{- else if eq $agent.mcp.method "vscode-json" }}
Write-Status -Label '{{ $agent.displayName }}' -Status ok -Detail 'managed VS Code mcp.json'
{{- else if eq $agent.mcp.method "codex-toml" }}
Write-TomlStatus -Agent '{{ $agentName }}' -Label '{{ $agent.displayName }}' -File '{{ $agent.mcp.file }}'
{{- else if ne $agent.mcp.method "none" }}
Write-Status -Label '{{ $agent.displayName }}' -Status fail -Detail "unknown mcp.method '{{ $agent.mcp.method }}'"
Add-Note "{{ $name }}: unknown mcp.method '{{ $agent.mcp.method }}' for {{ $agentName }} - see docs/pages/ai-tools.md."
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# -- Plugins --------------------------------------------
Write-Category "Plugins"
{{- range $name, $tool := .aiTools.plugin }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Item -Name '{{ $name }}' -Detail 'skipped: personal tool on a work computer'
{{- else }}
Write-Item -Name '{{ $name }}'
{{- range $agentName := $agentNames }}
{{- $agent := index $.aiAgents $agentName }}
{{- $entry := get $tool $agentName }}
{{- if and $agent.plugins.supported $entry }}
Add-Tracked 'plugin|{{ $agent.cli }}|{{ $entry.install }}|'
Install-Plugin -Name '{{ $name }}' -Label '{{ $agent.displayName }}' -Cli '{{ $agent.cli }}' -MarketplaceAdd '{{ $entry.marketplaceAdd }}' -Install '{{ $entry.install }}'
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# -- Skills ---------------------------------------------
Write-Category "Skills"
{{- range $name, $tool := .aiTools.skill }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Item -Name '{{ $name }}' -Detail 'skipped: personal tool on a work computer'
{{- else }}
Write-Item -Name '{{ $name }}'
{{- range $agentName := $agentNames }}
{{- $agent := index $.aiAgents $agentName }}
{{- if and $agent.skills.cliAgent (includeTemplate "ai-targets" (dict "tool" $tool "agent" $agentName "agents" $.aiAgents)) }}
{{- if $tool.skill }}
Add-Tracked 'skill|{{ $agent.skills.cliAgent }}|{{ $tool.skill }}|'
{{- end }}
Install-Skill -Name '{{ $name }}' -Label '{{ $agent.displayName }}' -Repo '{{ $tool.repo }}' -Skill '{{ $tool.skill | default "" }}' -Agent '{{ $agent.skills.cliAgent }}'
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# -- Packages -------------------------------------------
Write-Category "Packages"
{{- range $name, $tool := .aiTools.package }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Item -Name '{{ $name }}' -Detail 'skipped: personal tool on a work computer'
{{- else }}
Write-Item -Name '{{ $name }}' -Detail 'installed by mise'
{{- if $tool.postInstall }}
Invoke-PostInstall -Name '{{ $name }}' -Cmd '{{ $tool.postInstall | replace "'" "''" }}'
{{- end }}
{{- if $tool.projectNote }}
Add-Note '{{ $name }}: {{ $tool.projectNote | replace "'" "''" }}'
{{- end }}
{{- end }}
{{- end }}

# -- Custom skills and agents ---------------------------
Write-Category "Custom skills and agents"
{{- range $name, $tool := .aiTools.custom }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Item -Name '{{ $name }}' -Detail 'skipped: personal tool on a work computer'
{{- else }}
Write-Item -Name '{{ $name }}' -Detail '{{ $tool.kind }}'
{{- range $agentName := $agentNames }}
{{- $agent := index $.aiAgents $agentName }}
{{- if includeTemplate "ai-targets" (dict "tool" $tool "agent" $agentName "agents" $.aiAgents) }}
{{- $destDir := ternary $agent.skills.agentsDir $agent.skills.dir (eq $tool.kind "agent") }}
{{- if $destDir }}
Add-Tracked 'custom|{{ $destDir }}|{{ $name }}|{{ if eq $tool.kind "skill" }}{{ $agent.skills.manifest }}{{ end }}'
{{- end }}
Copy-Custom -Name '{{ $name }}' -Label '{{ $agent.displayName }}' -Kind '{{ $tool.kind }}' -DestDir '{{ $destDir }}' -Manifest '{{ $agent.skills.manifest }}'
{{- end }}
{{- end }}
{{- end }}
{{- end }}

Invoke-Prune

Write-Host ""
if ($script:Notes.Count -gt 0) {
    Write-Host "Follow-ups" -ForegroundColor Yellow
    foreach ($n in $script:Notes) { Write-Host "  - $n" }
    Write-Host ""
}
$summaryColor = if ($script:Counts.fail -gt 0) { 'Red' } else { 'Green' }
Write-Host "AI tools sync complete: $($script:Counts.ok) ok, $($script:Counts.skip) skipped, $($script:Counts.fail) failed" -ForegroundColor $summaryColor
