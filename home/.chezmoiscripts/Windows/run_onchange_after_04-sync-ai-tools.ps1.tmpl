# -------------------------------------------------------
# AI Tools Sync (PowerShell, templated)
# Installs/updates AI tools declared in .chezmoidata/ai-tools.yaml:
#   aiTools.mcp     -> registers the server with Claude Code (user scope)
#   aiTools.plugin  -> adds the marketplace + installs the plugin (Claude / Copilot)
#   aiTools.skill   -> installs a published skill via `npx skills add` (Claude / Copilot)
#   aiTools.package -> runs any postInstall step (the package itself is handled by mise)
#   aiTools.custom  -> copies your authored skill/agent from ~/.ai into each assistant
# forPersonal-skipped tools are reported, never installed.
# Copilot MCP servers are provided via the managed VS Code mcp.json instead.
#
# NOT elevated — MCPs/skills must register for the current user, not Administrator.
# Every external command is best-effort so `chezmoi apply` never fails on a
# not-yet-installed CLI.
# -------------------------------------------------------

$script:Notes = @()
function Add-Note { param([string]$Text) $script:Notes += $Text }
function Test-Cmd { param([string]$Name) [bool](Get-Command $Name -ErrorAction SilentlyContinue) }

# Windows PowerShell rebuilds a native command line from the argument strings
# and does NOT escape embedded double quotes, so '{"a":1}' reaches the child
# process as '{a:1}' -- which is how every `claude mcp add-json` call used to
# die with "Invalid configuration: : Invalid input". PowerShell 7.3+ fixed this
# with $PSNativeCommandArgumentPassing, except in 'Windows' mode when the target
# is a .cmd/.bat shim (which is how npm-installed CLIs land on PATH). Escape to
# the CommandLineToArgvW rules whenever the legacy behavior is in play: double
# any run of backslashes preceding a quote, then backslash-escape the quote.
function ConvertTo-NativeArg {
    param([string]$Value, [string]$Command)
    $mode = if ($PSVersionTable.PSVersion.Major -ge 7) {
        $ExecutionContext.SessionState.PSVariable.GetValue('PSNativeCommandArgumentPassing')
    } else { 'Legacy' }
    if ($mode -eq 'Standard') { return $Value }
    if ($mode -eq 'Windows') {
        $source = (Get-Command $Command -ErrorAction SilentlyContinue).Source
        if ($source -notmatch '\.(cmd|bat)$') { return $Value }
    }
    [regex]::Replace($Value, '(\\*)"', '$1$1\"')
}

function Register-ClaudeMcp {
    param([string]$Name, [string]$Json)
    if (-not (Test-Cmd "claude")) { Add-Note "claude CLI not found - register MCP '$Name' later with 'chezmoi apply'."; return }
    claude mcp remove $Name --scope user 2>$null | Out-Null
    claude mcp add-json --scope user $Name (ConvertTo-NativeArg -Value $Json -Command "claude")
    if ($LASTEXITCODE -eq 0) { Write-Host "  Claude MCP '$Name' registered" }
    else { Add-Note "Failed to register Claude MCP '$Name' (claude mcp add-json exited $LASTEXITCODE)." }
}

function Install-Plugin {
    param([string]$Name, [string]$Cli, [string]$MarketplaceAdd, [string]$Install)
    if (-not (Test-Cmd $Cli)) { Add-Note "$Cli not found - install plugin '$Name' later: $Cli plugin install $Install"; return }
    if ($MarketplaceAdd) {
        & $Cli plugin marketplace add $MarketplaceAdd 2>&1 | Out-Null
        if ($LASTEXITCODE -ne 0) { Add-Note "$Cli could not add marketplace '$MarketplaceAdd' (exit $LASTEXITCODE) - plugin '$Name' cannot install until it does." }
    }
    # Echo each line as it arrives and collect it, so a slow install still shows
    # progress while the output stays available for the os-error-5 check below.
    $out = & $Cli plugin install $Install 2>&1 | ForEach-Object { Write-Host $_; $_ }
    $code = $LASTEXITCODE
    if ($code -eq 0) { Write-Host "  $Cli plugin '$Name' installed"; return }
    $note = "Could not install plugin '$Name' for $Cli (exit $code) - run manually: $Cli plugin install $Install"
    if (($out | Out-String) -match 'os error 5|Access is denied') {
        # github/copilot-cli#4095 / #4151: Windows cannot replace the installed-plugins
        # folder while VS Code or a live CLI session holds watcher handles on it.
        $note += ". Windows denied the plugin folder swap - close VS Code and any running $Cli session, then re-run 'chezmoi apply --force'."
    }
    Add-Note $note
}

function Install-Skill {
    param([string]$Name, [string]$Repo, [string]$Skill, [string]$Agent)
    $cliArgs = @("skills", "add", $Repo)
    if ($Skill) { $cliArgs += @("--skill", $Skill) }
    $cliArgs += @("--agent", $Agent, "-g", "-y")
    $manual = "npx --yes $($cliArgs -join ' ')"
    if (-not (Test-Cmd "npx")) { Add-Note "npx not found - install skill '$Name' later: $manual"; return }
    & npx --yes @cliArgs
    if ($LASTEXITCODE -eq 0) { Write-Host "  skill '$Name' installed for $Agent" }
    else { Add-Note "Could not install skill '$Name' for $Agent - run manually: $manual" }
}

function Invoke-PostInstall {
    param([string]$Name, [string]$Cmd)
    Write-Host "  postInstall: $Cmd"
    try { Invoke-Expression $Cmd; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
    catch { Add-Note "postInstall for '$Name' failed - run manually: $Cmd" }
}

function Update-CopilotManifest {
    param([string]$Name)
    $manifest = Join-Path $HOME ".agents/.copilot-for-azure-skills-manifest.json"
    if (-not (Test-Path $manifest)) { return }
    try {
        $json = Get-Content $manifest -Raw | ConvertFrom-Json
        $skills = @($json.skills)
        if ($skills -notcontains $Name) {
            $json.skills = @(($skills + $Name) | Sort-Object)
            $json | ConvertTo-Json -Depth 20 | Set-Content $manifest
            Write-Host "  registered '$Name' in Copilot skills manifest"
        }
    } catch { Add-Note "Could not update Copilot skills manifest for '$Name'." }
}

function Copy-Custom {
    param([string]$Name, [string]$Kind, [string]$Assistant)
    $sub = if ($Kind -eq "agent") { "agents" } else { "skills" }
    $src = Join-Path $HOME ".ai/$sub/$Name"
    if (-not (Test-Path $src)) { Add-Note "custom $Kind '$Name' has no source at $src - author it under home/dot_ai/$sub/$Name/."; return }
    $targets = @()
    if ($Assistant -eq "claude" -or $Assistant -eq "both") { $targets += (Join-Path $HOME ".claude/$sub/$Name") }
    if (($Assistant -eq "copilot" -or $Assistant -eq "both") -and $Kind -eq "skill") { $targets += (Join-Path $HOME ".agents/skills/$Name") }
    foreach ($dest in $targets) {
        New-Item -ItemType Directory -Force -Path (Split-Path $dest -Parent) | Out-Null
        if (Test-Path $dest) { Remove-Item -Recurse -Force $dest }
        Copy-Item -Recurse -Force $src $dest
        Write-Host "  copied $Kind '$Name' -> $dest"
    }
    if (($Assistant -eq "copilot" -or $Assistant -eq "both") -and $Kind -eq "skill") { Update-CopilotManifest $Name }
}

Write-Host "Syncing AI tools (skills, agents, MCPs)"
Write-Host "--------------------------------------"
{{ range $name, $tool := .aiTools.mcp }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Host "Skipping {{ $name }} (personal tool on a work computer)"
{{- else }}
Write-Host "`n* {{ $name }} (mcp, {{ $tool.assistant }})"
{{- if or (eq $tool.assistant "claude") (eq $tool.assistant "both") }}
Register-ClaudeMcp -Name '{{ $name }}' -Json '{{ includeTemplate "mcp-server-json" $tool.config | replace "'" "''" }}'
{{- end }}
{{- if or (eq $tool.assistant "copilot") (eq $tool.assistant "both") }}
Write-Host "  Copilot MCP for {{ $name }} is provided via managed VS Code mcp.json"
{{- end }}
{{- end }}
{{ end }}
{{ range $name, $tool := .aiTools.plugin }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Host "Skipping {{ $name }} (personal tool on a work computer)"
{{- else }}
Write-Host "`n* {{ $name }} (plugin)"
{{- if $tool.claude }}
Install-Plugin -Name '{{ $name }}' -Cli 'claude' -MarketplaceAdd '{{ $tool.claude.marketplaceAdd }}' -Install '{{ $tool.claude.install }}'
{{- end }}
{{- if $tool.copilot }}
Install-Plugin -Name '{{ $name }}' -Cli 'copilot' -MarketplaceAdd '{{ $tool.copilot.marketplaceAdd }}' -Install '{{ $tool.copilot.install }}'
{{- end }}
{{- end }}
{{ end }}
{{ range $name, $tool := .aiTools.skill }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Host "Skipping {{ $name }} (personal tool on a work computer)"
{{- else }}
Write-Host "`n* {{ $name }} (skill, {{ $tool.assistant }})"
{{- if or (eq $tool.assistant "claude") (eq $tool.assistant "both") }}
Install-Skill -Name '{{ $name }}' -Repo '{{ $tool.repo }}' -Skill '{{ $tool.skill | default "" }}' -Agent 'claude-code'
{{- end }}
{{- if or (eq $tool.assistant "copilot") (eq $tool.assistant "both") }}
Install-Skill -Name '{{ $name }}' -Repo '{{ $tool.repo }}' -Skill '{{ $tool.skill | default "" }}' -Agent 'github-copilot'
{{- end }}
{{- end }}
{{ end }}
{{ range $name, $tool := .aiTools.package }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Host "Skipping {{ $name }} (personal tool on a work computer)"
{{- else }}
Write-Host "`n* {{ $name }} (package)"
{{- if $tool.postInstall }}
Invoke-PostInstall -Name '{{ $name }}' -Cmd '{{ $tool.postInstall | replace "'" "''" }}'
{{- end }}
{{- if $tool.projectNote }}
Add-Note '{{ $name }}: {{ $tool.projectNote | replace "'" "''" }}'
{{- end }}
{{- end }}
{{ end }}
{{ range $name, $tool := .aiTools.custom }}
{{- if and $tool.forPersonal $.workComputer }}
Write-Host "Skipping {{ $name }} (personal tool on a work computer)"
{{- else }}
Write-Host "`n* {{ $name }} (custom, {{ $tool.assistant }})"
Copy-Custom -Name '{{ $name }}' -Kind '{{ $tool.kind }}' -Assistant '{{ $tool.assistant }}'
{{- end }}
{{ end }}
Write-Host ""
if ($script:Notes.Count -gt 0) {
    Write-Host "Follow-ups:"
    foreach ($n in $script:Notes) { Write-Host "  - $n" }
}
Write-Host "AI tools sync complete"
