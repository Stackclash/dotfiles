{{ template "elevate-powershell" }}

# -------------------------------------------------------
# VS Code Extension Sync Script (PowerShell, templated)
# Reads profile definitions from .chezmoidata/vscode-profiles.yaml
# Syncs extensions per VS Code profile.
# -------------------------------------------------------

# vscode profiles hash: {{ .vscodeProfiles | toYaml | sha256sum }}

# Toggle removal of extensions not declared in YAML
$RemoveExtra = $true

# Ensure code CLI exists
if (-not (Get-Command "code" -ErrorAction SilentlyContinue)) {
    Write-Host "ERROR: VS Code command 'code' not found in PATH."
    exit 1
}

# Common Extensions (from YAML)
$CommonExtensions = @(
{{- $last := sub (len .vscodeProfiles.common_extensions) 1 }}
{{- range $i, $ext := .vscodeProfiles.common_extensions }}
    "{{ $ext }}"{{ if ne $i $last }},{{ end }}
{{- end }}
)

# Profile-specific extensions (from YAML)
$Profiles = @{
{{- range $profileName, $profileData := .vscodeProfiles.profiles }}
    "{{ $profileName }}" = @(
        {{- $last := sub (len $profileData.extensions) 1 }}
        {{- range $i, $ext := $profileData.extensions }}
        "{{ $ext }}"{{ if ne $i $last }},{{ end }}
        {{- end }}
    );
{{- end }}
}

# Expands declared extensions with their extensionPack / extensionDependencies
# members (recursively) so bundle members aren't treated as undeclared.
function Get-ProtectedExtensions($declared) {
    $extDir = Join-Path $env:USERPROFILE ".vscode\extensions"
    $seen = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    $queue = [System.Collections.Generic.Queue[string]]::new()
    foreach ($d in $declared) { $queue.Enqueue($d) }
    while ($queue.Count -gt 0) {
        $id = $queue.Dequeue()
        if (-not $seen.Add($id)) { continue }
        $pattern = '^' + [regex]::Escape($id) + '-\d'
        $dir = Get-ChildItem $extDir -Directory -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -match $pattern } | Select-Object -First 1
        if (-not $dir) { continue }
        $pkgPath = Join-Path $dir.FullName "package.json"
        if (-not (Test-Path $pkgPath)) { continue }
        try {
            $pkg = Get-Content $pkgPath -Raw | ConvertFrom-Json
            foreach ($m in (@($pkg.extensionPack) + @($pkg.extensionDependencies))) {
                if ($m) { $queue.Enqueue($m) }
            }
        } catch {}
    }
    return , $seen
}

Write-Host "VS Code Extension Sync"
Write-Host "------------------------"

# --- Base VS Code (no profile) ---
Write-Host ""
Write-Host "=== Base VS Code ==="

try {
    $installedExtensions = code --list-extensions 2>$null
    if ($null -eq $installedExtensions) {
        $installedExtensions = @()
    }
}
catch {
    Write-Host "Could not list installed extensions for base VS Code."
    Write-Host "Assuming no extensions installed."
    $installedExtensions = @()
}

foreach ($ext in $CommonExtensions) {
    if ($installedExtensions -notcontains $ext) {
        Write-Host "  + Installing: $ext"
        try {
            code --install-extension $ext | Out-Null
        } catch {
            Write-Host "  Failed to install $ext"
        }
    } else {
        Write-Host "  Already installed: $ext"
    }
}

if ($RemoveExtra) {
    Write-Host "Checking for extensions to remove..."
    $protected = Get-ProtectedExtensions $CommonExtensions
    foreach ($ext in $installedExtensions) {
        if (-not $protected.Contains($ext)) {
            Write-Host "  - Removing: $ext"
            try {
                code --uninstall-extension $ext | Out-Null
            } catch {
                Write-Host "  Failed to remove $ext"
            }
        }
    }
} else {
    Write-Host "  Skipping removal of undeclared extensions: set \$RemoveExtra = \$true to enable"
}

Write-Host "Base VS Code synced."

foreach ($profileName in $Profiles.Keys) {
    Write-Host ""
    Write-Host "=== Profile: $profileName ==="

    # Combine common + profile-specific
    $desiredExtensions = $CommonExtensions + $Profiles[$profileName]

    code --profile "$profileName"

    # Attempt to read installed extensions
    try {
        $installedExtensions = code --profile "$profileName" --list-extensions 2>$null
        if ($null -eq $installedExtensions) {
            $installedExtensions = @()
        }
    }
    catch {
        Write-Host "Could not list installed extensions for profile '$profileName'."
        Write-Host "Assuming no extensions installed."
        $installedExtensions = @()
    }

    # Install missing extensions
    foreach ($ext in $desiredExtensions) {
        if ($installedExtensions -notcontains $ext) {
            Write-Host "  + Installing: $ext"
            try {
                code --install-extension $ext --profile "$profileName" | Out-Null
            } catch {
                Write-Host "  Failed to install $ext"
            }
        } else {
            Write-Host "  Already installed: $ext"
        }
    }

    # Optionally remove extra extensions
    if ($RemoveExtra) {
        Write-Host "Checking for extensions to remove..."
        $protected = Get-ProtectedExtensions $desiredExtensions
        foreach ($ext in $installedExtensions) {
            if (-not $protected.Contains($ext)) {
                Write-Host "  - Removing: $ext"
                try {
                    code --uninstall-extension $ext --profile "$profileName" | Out-Null
                } catch {
                    Write-Host "  Failed to remove $ext"
                }
            }
        }
    } else {
        Write-Host "  Skipping removal of undeclared extensions: set \$RemoveExtra = \$true to enable"
    }

    Write-Host "Profile synced: $profileName"
}

Write-Host ""
Write-Host "All profiles processed."