[tools]
node = "22"
"python" = "3.13"
"uv" = "latest"
"github:cli/cli" = { version = "latest", exe = "gh" }
"aqua:kubernetes/kubernetes/kubectl" = "latest"
"github:jqlang/jq" = "latest"
"github:DopplerHQ/cli" = "latest"
"aqua:JanDeDobbeleer/oh-my-posh" = "latest"
"aqua:cheat/cheat" = "latest"
"aqua:hashicorp/terraform" = "latest"
"aqua:terraform-docs/terraform-docs" = "latest"
"github:junegunn/fzf" = "latest" # Required for navi
"github:denisidoro/navi" = "2.22.1"
"aqua:sxyazi/yazi" = "latest"
"aqua:neovim/neovim" = "latest"
"github:twpayne/chezmoi" = "latest"
"aqua:yarnpkg/berry" = "latest"
"aqua:nektos/act" = "latest"
"github:ebullient/ttrpg-convert-cli" = "latest"
"aqua:astral-sh/uv" = "latest"
"core:bun" = "latest"
# Azure Tools
"vfox:mise-plugins/vfox-azure-functions-core-tools" = "latest"
# AI agent CLIs (generated from .chezmoidata/ai-agents.yaml -- edit that file, not here)
{{- range $name, $agent := .aiAgents }}
{{- if $agent.install }}
"{{ $agent.install.mise.backend }}:{{ $agent.install.mise.package }}" = "latest" # {{ $name }}
{{- end }}
{{- end }}
# AI Tools (generated from .chezmoidata/ai-tools.yaml -- edit that file, not here)
{{- range $name, $tool := .aiTools.package }}
{{- if and (not (hasPrefix "@" $tool.mise.package)) (contains "@" $tool.mise.package) }}
{{- $parts := splitList "@" $tool.mise.package }}
"{{ $tool.mise.backend }}:{{ index $parts 0 }}" = "{{ index $parts 1 }}" # {{ $name }}
{{- else }}
"{{ $tool.mise.backend }}:{{ $tool.mise.package }}" = "latest" # {{ $name }}
{{- end }}
{{- end }}

[env]
_.file = ".env"
_.path = ['{{ "{{cwd}}" }}/node_modules/.bin']
MISE_PWSH_CHPWD_WARNING = 0
NAVI_CONFIG = "~/.config/navi/config.yml"
UV_PRERELEASE = "allow"

[settings]
trusted_config_paths = ['{{ .projectPath }}']
