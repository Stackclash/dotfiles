{{- /* VS Code user-level MCP servers, generated from .chezmoidata/ai-tools.yaml.
       Rendered into <Code>/User/mcp.json (next to settings.json). Includes tools
       whose assistant is copilot or both. Each server's JSON is produced by the
       shared "mcp-server-json" template, so the schema (full `config:` blocks +
       {{ .secret }} templating) stays identical across Claude and VS Code. */ -}}
{{- $mcpEntries := list -}}
{{- range $name, $tool := .aiTools -}}
  {{- if and (eq $tool.type "mcp") (or (eq $tool.assistant "copilot") (eq $tool.assistant "both")) -}}
    {{- $json := includeTemplate "mcp-server-json" (dict "mcp" $tool.mcp "root" $) -}}
    {{- $mcpEntries = append $mcpEntries (printf "    %s: %s" (toJson $name) $json) -}}
  {{- end -}}
{{- end -}}
{
  "servers": {
{{ $mcpEntries | join ",\n" }}
  }
}
