{{- /* VS Code user-level MCP servers, generated from .chezmoidata/ai-tools.yaml.
       Rendered into <Code>/User/mcp.json (next to settings.json). Includes tools
       whose assistant is copilot or both. */ -}}
{{- $mcpEntries := list -}}
{{- range $name, $tool := .aiTools -}}
  {{- if and (eq $tool.type "mcp") (or (eq $tool.assistant "copilot") (eq $tool.assistant "both")) -}}
    {{- $m := $tool.mcp -}}
    {{- if or (eq $m.transport "http") (eq $m.transport "sse") -}}
      {{- $server := dict "type" $m.transport "url" $m.url -}}
      {{- $key := default "" (index $ (default "" $m.apiKeyFrom)) -}}
      {{- if and $m.apiKeyFrom $key -}}
        {{- $server = merge $server (dict "headers" (dict $m.apiKeyHeader $key)) -}}
      {{- end -}}
      {{- $mcpEntries = append $mcpEntries (printf "    \"%s\": %s" $name (toJson $server)) -}}
    {{- else -}}
      {{- $server := dict "type" "stdio" "command" $m.command "args" $m.args -}}
      {{- if $m.env -}}{{- $server = merge $server (dict "env" $m.env) -}}{{- end -}}
      {{- $mcpEntries = append $mcpEntries (printf "    \"%s\": %s" $name (toJson $server)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{
  "servers": {
{{ $mcpEntries | join ",\n" }}
  }
}
