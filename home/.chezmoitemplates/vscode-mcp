{{- /* VS Code user-level MCP servers, generated from .chezmoidata/ai-tools.yaml.
       Rendered into <Code>/User/mcp.json (next to settings.json). Includes tools
       whose assistant is copilot or both. */ -}}
{{- $mcpEntries := list -}}
{{- range $name, $tool := .aiTools.mcp -}}
  {{- if or (eq $tool.assistant "copilot") (eq $tool.assistant "both") -}}
    {{- $json := includeTemplate "mcp-server-json" $tool.config -}}
    {{- $mcpEntries = append $mcpEntries (printf "    \"%s\": %s" $name $json) -}}
  {{- end -}}
{{- end -}}
{
  "servers": {
{{ $mcpEntries | join ",\n" }}
  }
}
