{{- /*
  Prints "true" on Omarchy, nothing elsewhere. Built on chezmoi's own OS data:
  .chezmoi.osRelease only exists on Linux, so check .chezmoi.os first.
  Usage: {{ if includeTemplate "is-omarchy" . }} ... {{ end }}
*/ -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if eq (.chezmoi.osRelease.id | default "") "omarchy" -}}true{{- end -}}
{{- end -}}
