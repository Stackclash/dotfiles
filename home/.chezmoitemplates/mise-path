{{- if eq .chezmoi.os "windows" -}}
# chezmoi's environment predates PATH changes made earlier in this apply (a
# fresh mise install, the shims directory), so re-read PATH from the registry.
$env:Path = @($env:Path, [Environment]::GetEnvironmentVariable('Path', 'Machine'), [Environment]::GetEnvironmentVariable('Path', 'User')) -join ';'
{{- else -}}
# Non-interactive: no rc file ran, so reach mise tools through its shims.
{{- if eq .chezmoi.os "darwin" }}
# macOS: mise comes from Homebrew, which may not be on PATH yet.
if ! command -v mise >/dev/null 2>&1; then
    if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
fi
{{- end }}
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"
{{- end -}}
